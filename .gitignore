# Dart / Flutter
.dart_tool/
.packages
build/
!app/build/board-previews/
pubspec.lock
# ...except the server's. The packages are libraries, where a lock file would
# hide version incompatibilities from consumers; the server is an application that gets
# built into an image and deployed, and it must resolve the same dependency
# versions today and in six months.
!server/pubspec.lock
*.iml

# Flutter app artifacts (added in the app phase)
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/ios/Pods/
app/android/.gradle/
app/android/local.properties

# Editors
.idea/
.vscode/
*.swp
.DS_Store
